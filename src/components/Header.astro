---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
import PlanBadge from './PlanBadge.astro';
import { PRIMARY_NAV, FEATURE_GROUPS } from '../data/nav.ts';
import { SITE } from '../data/site.ts';

/**
 * The desktop nav is DRIVEN by `PRIMARY_NAV`, not hand-written.
 *
 * It used to hard-code Features / Download / Docs and read `PRIMARY_NAV` only
 * in the mobile menu, so `/lens` and `/pricing` — the paid product and the page
 * that sells it — had no desktop link at all. Anyone on a laptop could reach
 * them only from a footer or an in-page link. Adding a row to `PRIMARY_NAV` now
 * puts it in both menus, which is the point of having the list.
 *
 * External rows (Sign in) are pulled out and rendered beside the call to
 * action, where people look for them, rather than sitting mid-sentence among
 * the product pages.
 */
const navItems = PRIMARY_NAV.filter((item) => !item.external);
const externalItems = PRIMARY_NAV.filter((item) => item.external);

/** Current section, for the active state. `/features/cli` lights up Features. */
const here = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string): boolean => here === href || here.startsWith(`${href}/`);
---
<header
  class="sticky top-0 z-50 border-b border-edge/70 bg-bg/80 backdrop-blur-xl supports-[backdrop-filter]:bg-bg/65"
>
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <Logo />

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {
        navItems.map((item) =>
          item.href === '/features' ? (
            <div class="group relative">
              {/* A link, not a button. As a button the dropdown listed the
                  feature pages but /features itself had no desktop link at all
                  -- the same gap /lens and /pricing had. Hover and focus still
                  open the panel; a click now goes to the index. */}
              <a
                href={item.href}
                aria-haspopup="true"
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class:list={[
                  'inline-flex items-center gap-1 rounded-lg px-3 py-2 text-sm font-medium transition-colors hover:text-fg',
                  isCurrent(item.href) ? 'text-fg' : 'text-fg-muted',
                ]}
              >
                {item.label}
                <Icon name="chevron-down" size={15} class="transition-transform group-hover:rotate-180" />
              </a>
              {/* Anchored to the link's left edge, not centred on it: centred, a
                  panel this wide ran off the left of a 1024px window. One column
                  per product, Lens first, each row carrying its plan so the menu
                  never reads as one free feature set. */}
              <div class="invisible absolute left-0 top-full w-[44rem] max-w-[calc(100vw-2rem)] pt-3 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                <div class="grid grid-cols-2 gap-2 rounded-2xl border border-edge bg-panel p-3 shadow-panel">
                  {FEATURE_GROUPS.map((group) => (
                    <div>
                      <a
                        href={group.href}
                        class="flex h-8 items-center justify-between rounded-lg px-3 text-xs font-semibold uppercase tracking-wider text-fg-dim transition-colors hover:text-brand"
                      >
                        {group.title}
                        {group.product === 'studio' && <PlanBadge plan="free" />}
                      </a>
                      <ul>
                        {group.items.map((item) => (
                          <li>
                            <a
                              href={item.href}
                              class="flex items-center justify-between gap-3 rounded-lg px-3 py-1.5 text-sm font-medium text-fg-muted transition-colors hover:bg-surface hover:text-brand"
                            >
                              <span class="truncate">{item.label}</span>
                              {group.product === 'lens' && <PlanBadge plan={item.plan} class="shrink-0" />}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class:list={[
                'rounded-lg px-3 py-2 text-sm font-medium transition-colors hover:text-fg',
                isCurrent(item.href) ? 'text-fg' : 'text-fg-muted',
              ]}
            >
              {item.label}
            </a>
          ),
        )
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={SITE.links.github}
        target="_blank"
        rel="noopener"
        class="hidden h-9 w-9 items-center justify-center rounded-lg border border-edge bg-panel text-fg-muted transition-colors hover:border-brand hover:text-brand sm:inline-flex"
        aria-label="API Circle on GitHub"
      >
        <Icon name="github" size={18} />
      </a>
      <ThemeToggle />
      {
        externalItems.map((item) => (
          <a
            href={item.href}
            target="_blank"
            rel="noopener"
            class="hidden rounded-lg px-3 py-2 text-sm font-medium text-fg-muted transition-colors hover:text-fg lg:inline-flex"
          >
            {item.label}
          </a>
        ))
      }
      <a href="/download" class="btn-primary hidden sm:inline-flex">
        <Icon name="download" size={16} />
        Download Lens
      </a>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-edge bg-panel text-fg lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="4" x2="20" y1="6" y2="6"></line>
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="4" x2="20" y1="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-edge bg-panel lg:hidden">
    <nav class="container-page flex flex-col gap-1 py-4" aria-label="Mobile">
      <a
        href="/features"
        class="px-3 pb-1 pt-2 text-xs font-semibold uppercase tracking-wider text-fg-dim hover:text-fg"
      >
        Features
      </a>
      {/* Two jump links, not every feature: twenty rows would push the rest of
          the menu off a phone screen. */}
      {
        FEATURE_GROUPS.map((group) => (
          <a
            href={group.href}
            class="flex items-center justify-between rounded-lg px-3 py-2 text-sm font-medium text-fg-muted hover:bg-surface hover:text-fg"
          >
            {group.title} features
            {group.product === 'studio' && <PlanBadge plan="free" />}
          </a>
        ))
      }
      <div class="my-2 border-t border-edge"></div>
      {
        PRIMARY_NAV.filter((i) => i.href !== '/features').map((item) => (
          <a
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener' : undefined}
            aria-current={!item.external && isCurrent(item.href) ? 'page' : undefined}
            class="rounded-lg px-3 py-2 text-sm font-medium text-fg-muted hover:bg-surface hover:text-fg"
          >
            {item.label}
          </a>
        ))
      }
      <a href="/download" class="btn-primary mt-2 w-full">
        <Icon name="download" size={16} />
        Download Lens
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    btn.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(!open));
    });
    // A same-page anchor (/features#lens while on /features) does not reload,
    // so the menu would stay open over the section it just scrolled to.
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      });
    });
  })();
</script>
