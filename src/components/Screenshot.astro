---
import { existsSync } from 'node:fs';
import { join } from 'node:path';

/**
 * Theme-aware product screenshot. Renders both the light and dark capture and
 * shows the one matching the active site theme (the `dark` class on <html>).
 *
 * Images live in /public/screenshots/{light,dark}/<name>.webp, captured from
 * the real app by `lens/regression/capture_marketing.py` — light uses GitHub
 * Light, dark uses One Dark Pro — so the product matches the page around it.
 */
interface Props {
  name: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  eager?: boolean;
  rounded?: boolean;
}
const {
  name,
  alt,
  width = 2560,
  height = 1600,
  class: className = '',
  eager = false,
  rounded = false,
} = Astro.props;

// A missing file used to ship as a broken <img> through a green build, and only
// in the theme nobody was looking at: dark is the default, so a missing dark
// capture is invisible to whoever added the light one. Frontmatter runs at
// build time, so a name without BOTH captures fails the build instead, the way
// Icon and PlanBadge fail on an unknown name.
const missing = ['dark', 'light'].filter(
  (theme) => !existsSync(join(process.cwd(), 'public', 'screenshots', theme, `${name}.webp`)),
);
if (missing.length > 0) {
  throw new Error(
    `<Screenshot name="${name}"> has no ${missing.join(' or ')} capture in public/screenshots/. ` +
      'Capture both themes with lens/regression/capture_marketing.py, then run scripts/process-screenshots.mjs.',
  );
}

const imgClass = [
  'block h-auto w-full',
  rounded && 'rounded-xl',
].filter(Boolean).join(' ');
const loading = eager ? 'eager' : 'lazy';
---
<div
  class:list={['relative w-full bg-surface', className]}
  style={`aspect-ratio: ${width} / ${height};`}
>
  <img
    src={`/screenshots/light/${name}.webp`}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
    class:list={[imgClass, 'absolute inset-0 block dark:hidden']}
  />
  <img
    src={`/screenshots/dark/${name}.webp`}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
    class:list={[imgClass, 'absolute inset-0 hidden dark:block']}
  />
</div>
