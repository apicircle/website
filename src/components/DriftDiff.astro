---
import Icon from './Icon.astro';

/** One line on one side of the comparison. */
export interface DiffLine {
  text: string;
  /** Marks the line the finding is about — tinted, and prefixed for screen readers. */
  changed?: boolean;
}

interface Props {
  /** The endpoint under review, e.g. `POST /api/v1/widgets`. */
  endpoint: string;
  /** Ref names as a reader would see them on the host. */
  baseRef?: string;
  headRef?: string;
  /** How Lens grades it. Drives the chip's colour and its accessible text. */
  severity?: 'breaking' | 'warning' | 'info';
  /** The finding's own tags, as the Review panel prints them. */
  tags?: string[];
  base: DiffLine[];
  head: DiffLine[];
  /** The sentence Lens reports, and where it points. */
  finding?: string;
  source?: string;
  class?: string;
}

const {
  endpoint,
  baseRef = 'main',
  headRef = 'your branch',
  severity = 'warning',
  tags = [],
  base,
  head,
  finding,
  source,
  class: className = '',
} = Astro.props;

/**
 * The before/after of one drift finding.
 *
 * HTML, deliberately, not a screenshot. A picture of this would need
 * re-capturing every time a label moves, would carry no text for search or for
 * a screen reader, and would ship one fixed colour scheme into a site that has
 * two. Rendered as markup it themes itself, is indexable, and cannot go stale
 * against a UI it does not depend on.
 *
 * It is an ILLUSTRATION built from props — a drawing of what the product
 * reports, not a live reading of it. Every instance on the site must be written
 * from something the product genuinely finds.
 */
const SEVERITY: Record<string, { label: string; chip: string }> = {
  breaking: { label: 'Breaking', chip: 'border-node-red/40 bg-node-red/10 text-node-red' },
  warning: { label: 'Warning', chip: 'border-node-amber/40 bg-node-amber/10 text-node-amber' },
  info: { label: 'Info', chip: 'border-edge bg-surface text-fg-dim' },
};
const tone = SEVERITY[severity] ?? SEVERITY.warning;

const sides: Array<{ ref: string; lines: DiffLine[]; tint: string; word: string }> = [
  { ref: baseRef, lines: base, tint: 'text-node-red', word: 'Removed' },
  { ref: headRef, lines: head, tint: 'text-node-green', word: 'Added' },
];
---
<figure
  class:list={['overflow-hidden rounded-2xl border border-edge bg-panel shadow-card', className]}
>
  <figcaption class="flex flex-wrap items-center gap-x-3 gap-y-2 border-b border-edge bg-surface/60 px-5 py-3">
    <span class="font-mono text-sm font-semibold text-fg">{endpoint}</span>
    <span
      class:list={['inline-flex items-center rounded-full border px-2 py-0.5 text-[0.6875rem] font-semibold uppercase tracking-wide', tone.chip]}
    >
      {tone.label}
    </span>
    {
      tags.length > 0 && (
        <span class="ml-auto font-mono text-xs text-fg-dim">{tags.join(', ')}</span>
      )
    }
  </figcaption>

  <div class="grid gap-px bg-edge sm:grid-cols-2">
    {
      sides.map((side) => (
        <div class="bg-panel px-5 py-4">
          <p class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-fg-dim">
            <Icon name="git-branch" size={13} />
            {side.ref}
          </p>
          <pre class="mt-3 overflow-x-auto font-mono text-[13px] leading-relaxed"><code>{side.lines.map((line) => (
            <span class:list={['block', line.changed ? side.tint : 'text-fg-muted']}>{line.changed && <span class="sr-only">{side.word}: </span>}{line.text || ' '}</span>
          ))}</code></pre>
        </div>
      ))
    }
  </div>

  {
    finding && (
      <p class="border-t border-edge px-5 py-4 text-[15px] leading-relaxed text-fg-muted">
        {finding}
        {source && <span class="ml-1 font-mono text-[13px] text-fg-dim">· {source}</span>}
      </p>
    )
  }
</figure>
