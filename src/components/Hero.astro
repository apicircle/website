---
import Icon from './Icon.astro';
import AppFrame from './AppFrame.astro';
import Screenshot from './Screenshot.astro';
import { SITE } from '../data/site.ts';
import { TRIAL_DAYS } from '../data/pricing.ts';

/**
 * The homepage hero.
 *
 * The H1 names the mechanism rather than playing on `git diff`: someone
 * arriving from a search for "API drift" needs to recognise their problem in
 * the first line, and wordplay costs them that.
 *
 * The product shot is the drift review, because that is the claim the headline
 * makes. It used to be the request editor — the free workspace, under a
 * headline about the paid analysis.
 */
---
<section class="relative overflow-hidden">
  <!-- Background decoration -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-grid opacity-[0.15] mask-fade-b"></div>
    <div class="absolute -top-40 left-1/2 h-[36rem] w-[60rem] max-w-full -translate-x-1/2 rounded-full bg-brand/20 blur-[120px]"></div>
    <div class="absolute right-0 top-40 h-72 w-72 rounded-full bg-node-sky/15 blur-[90px]"></div>
  </div>

  <div class="container-page pb-16 pt-16 sm:pb-24 sm:pt-24">
    <div class="mx-auto max-w-3xl text-center">
      <a
        href={SITE.links.github}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full border border-edge bg-panel/80 px-3 py-1 text-xs font-medium text-fg-muted backdrop-blur transition-colors hover:border-brand hover:text-brand"
      >
        <span class="relative flex h-1.5 w-1.5">
          <span class="absolute inline-flex h-full w-full animate-pulse-ring rounded-full bg-node-green"></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-node-green"></span>
        </span>
        Self-funded, and built in the open
        <Icon name="arrow-right" size={12} />
      </a>

      <h1 class="mt-6 text-balance text-4xl font-bold leading-[1.08] tracking-tight text-fg sm:text-6xl">
        Know when a pull request
        <span class="gradient-text">changes your API</span>
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-pretty text-lg leading-relaxed text-fg-muted sm:text-xl">
        Lens reads your repository and maps every endpoint to the code that implements it. On each
        pull request it compares the branch against that map and against your OpenAPI spec, then
        tells you what moved.
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/download" class="btn-primary w-full sm:w-auto">
          <Icon name="download" size={16} />
          Download Lens
        </a>
        <a href={SITE.appUrl} target="_blank" rel="noopener" class="btn-secondary w-full sm:w-auto">
          Start free with Studio
          <Icon name="arrow-up-right" size={16} />
        </a>
      </div>

      <p class="mx-auto mt-5 max-w-xl text-sm leading-relaxed text-fg-dim">
        The API workspace is free and needs no account: write requests, run collections, mock an API
        on localhost. Every paid plan starts with a {TRIAL_DAYS}-day trial.
      </p>
    </div>

    <!-- Hero product shot -->
    <div class="relative mx-auto mt-16 max-w-5xl">
      <div class="pointer-events-none absolute -inset-x-8 -top-8 bottom-0 -z-10 rounded-[2rem] bg-gradient-to-b from-brand/15 to-transparent blur-2xl"></div>
      <AppFrame label="Review · Working tree" class="animate-fade-up">
        <Screenshot
          name="pr-review-drift"
          alt="The Review panel listing three changed endpoints, each with its drift findings and the file and line they point to"
          eager
        />
      </AppFrame>
    </div>
  </div>
</section>
