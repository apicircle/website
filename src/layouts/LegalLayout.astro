---
/**
 * Layout for the legal documents (src/pages/terms.md, privacy.md, refunds.md).
 *
 * The documents are Markdown so they read and review like documents. This adds
 * what every one of them needs: the version and effective date, a table of
 * contents, the draft banner, and the operator facts from `data/legal.ts`
 * substituted for their `{{TOKEN}}`s.
 */
import BaseLayout from './BaseLayout.astro';
import { LEGAL, fillLegalTokens } from '../data/legal.ts';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    /** Which document this is: picks its version and its path. */
    document: 'terms' | 'privacy' | 'refunds';
  };
  headings: { depth: number; slug: string; text: string }[];
}

const { frontmatter, headings } = Astro.props;
const path = `/${frontmatter.document}`;
// The Refund Policy is part of the Terms, so it carries the Terms version.
const version = frontmatter.document === 'privacy' ? LEGAL.privacyVersion : LEGAL.termsVersion;
const draft = LEGAL.status === 'draft';
const body = fillLegalTokens(await Astro.slots.render('default'));
const contents = headings.filter((h) => h.depth === 2);
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: frontmatter.title, url: path },
];
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  breadcrumbs={breadcrumbs}
  ogType="article"
  noindex={draft}
>
  <div class="container-page py-16 sm:py-20">
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow">Legal</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-fg sm:text-4xl">{frontmatter.title}</h1>
      <p class="mt-3 text-sm text-fg-muted">Version {version} · Effective {LEGAL.effectiveDate}</p>

      {
        draft && (
          <div
            role="note"
            class="mt-6 rounded-xl border border-node-amber/50 bg-node-amber/10 p-4 text-sm leading-relaxed text-fg"
          >
            <strong>Draft for legal review — not yet in force.</strong> Text in [square brackets] marks a detail
            that is still to be confirmed.
          </div>
        )
      }

      {
        contents.length > 0 && (
          <nav aria-label="On this page" class="mt-8 rounded-2xl border border-edge bg-panel p-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-fg-dim">On this page</p>
            <ol class="mt-3 grid gap-1.5 text-sm sm:grid-cols-2">
              {contents.map((h) => (
                <li>
                  <a class="text-fg-muted transition-colors hover:text-brand" href={`#${h.slug}`}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <article
        class="prose mt-10 max-w-none dark:prose-invert prose-headings:scroll-mt-24 prose-headings:text-fg prose-a:text-brand prose-strong:text-fg prose-th:text-fg prose-td:align-top"
        set:html={body}
      />

      <p class="mt-12 border-t border-edge pt-6 text-sm text-fg-muted">
        Questions about this document? Email
        <a class="text-brand hover:underline" href={`mailto:${LEGAL.supportEmail}`}>{LEGAL.supportEmail}</a>.
        Related: <a class="text-brand hover:underline" href="/terms">Terms of Service</a> ·
        <a class="text-brand hover:underline" href="/privacy">Privacy Policy</a> ·
        <a class="text-brand hover:underline" href="/refunds">Refund Policy</a>
      </p>
    </div>
  </div>
</BaseLayout>
