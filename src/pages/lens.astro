---
/**
 * API Circle Lens — the paid product.
 *
 * The rest of this site describes API Circle Studio, the free, open API workspace.
 * Lens is what the pricing page sells, so this page says plainly what it is, what
 * each plan delivers and how it is delivered: Paddle's domain review asks for
 * exactly that, and so does anyone deciding whether to buy.
 *
 * Facts only. The feature lines come from the same catalogue as the pricing page,
 * the framework list from the engine's own support matrix
 * (lens/packages-lens/rest-code-graph/src/support.ts). The Build pillar is
 * deliberately absent: it is hidden in the initial release.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Icon from '../components/Icon.astro';
import { PLANS, TRIAL_DAYS } from '../data/pricing.ts';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'API Circle Lens', url: '/lens' },
];

const accountUrl = 'https://account.apicircle.dev';

const pillars = [
  {
    icon: 'workflow',
    title: 'Code graph',
    body: 'Lens reads your repository and maps every API endpoint to the code that implements it: the route, the handler, the request and response it really uses, and the functions it calls. You can correct and extend the map, and it is saved in your repository so it is versioned with your code.',
  },
  {
    icon: 'git-merge',
    title: 'PR Review drift',
    body: 'For each pull request, Lens compares the change against the Code graph and your OpenAPI Spec, and shows where the API moves away from its contract: bodies, parameters, headers, status codes and authentication. Post the findings as review comments on GitHub, GitLab, Bitbucket or Azure DevOps.',
  },
  {
    icon: 'code',
    title: 'Drift-infill scaffolding',
    body: 'When your Spec declares an endpoint the code does not implement yet, Lens generates framework-native code for it, into your repository, for you to review.',
  },
  {
    icon: 'sparkles',
    title: 'AI Assistant, with your own key',
    body: 'Ask questions about your API and get answers grounded in the Code graph. The Assistant uses the AI provider you choose (Anthropic, OpenAI or Google Gemini) with your own API key, directly from your machine.',
  },
  {
    icon: 'plug',
    title: 'MCP server for your AI tools',
    body: 'Give Claude, Cursor, Copilot and other MCP clients the same Code graph you work from, through a server that runs locally.',
  },
  {
    icon: 'terminal',
    title: 'CLI for CI pipelines',
    body: 'Run PR Review in your pipeline and fail the build when a pull request drifts from the Spec, before it reaches review.',
  },
];

const frameworks = [
  { language: 'TypeScript and JavaScript', list: 'Express, Fastify, NestJS, Hono, Koa, Ts.ED, Next.js' },
  { language: 'Python', list: 'FastAPI, Flask, Django with DRF, Django Ninja' },
  { language: 'Go', list: 'gin, chi, echo, fiber, gorilla/mux, net/http, Huma' },
  { language: 'Java', list: 'Spring MVC, Spring WebFlux, Micronaut, JAX-RS / Jakarta' },
  { language: 'C#', list: 'ASP.NET Core minimal APIs and MVC' },
  { language: 'Rust', list: 'axum, actix-web, Rocket, Salvo, poem' },
];

// Which plan first includes each paid capability, straight from the catalogue.
const paid = PLANS.filter((p) => p.monthly !== null);
---

<BaseLayout
  title="API Circle Lens"
  description="API Circle Lens maps every endpoint in your codebase to the code that implements it, and checks each pull request against your OpenAPI Spec to catch API drift before it merges."
  breadcrumbs={breadcrumbs}
>
  <Section
    headingLevel="h1"
    eyebrow="API Circle Lens"
    eyebrowIcon="layers"
    title="Catch API drift before it merges."
    subtitle="Lens builds a Code graph of your API from its source, with every endpoint mapped to the code that implements it. It uses the Code graph and your OpenAPI Spec to show where a pull request moves your API away from its contract."
  >
    <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href="/pricing" class="btn-primary w-full sm:w-auto">
        See plans and pricing
        <Icon name="arrow-right" size={16} />
      </a>
      <a href={accountUrl} class="btn-secondary w-full sm:w-auto">
        Create your account
        <Icon name="arrow-up-right" size={16} />
      </a>
    </div>
    <p class="mt-4 text-center text-sm text-fg-muted">
      Every paid plan starts with a {TRIAL_DAYS}-day free trial. The API workspace itself stays free, with no account.
    </p>
  </Section>

  <Section eyebrow="What you get" eyebrowIcon="boxes" title="One app, from the map of your code to the review">
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        pillars.map((p) => (
          <div class="card">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-brand/10 text-brand">
              <Icon name={p.icon} size={20} />
            </span>
            <h3 class="mt-4 text-lg font-semibold text-fg">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-fg-muted">{p.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section
    eyebrow="Your code stays yours"
    eyebrowIcon="shield-check"
    title="Your code is analysed on your machine"
    subtitle="Lens indexes and analyses your repositories locally. Our servers receive no repository content, file paths or analysis results, only what an account and a licence need."
  >
    <div class="mx-auto grid max-w-4xl gap-5 md:grid-cols-3">
      <div class="card">
        <h3 class="text-base font-semibold text-fg">Local analysis</h3>
        <p class="mt-2 text-sm leading-relaxed text-fg-muted">
          The Code graph is built where your code is, and saved into your own repository.
        </p>
      </div>
      <div class="card">
        <h3 class="text-base font-semibold text-fg">Your keys, your providers</h3>
        <p class="mt-2 text-sm leading-relaxed text-fg-muted">
          AI features use the provider and key you choose, directly from your machine. Code host tokens stay on
          your device.
        </p>
      </div>
      <div class="card">
        <h3 class="text-base font-semibold text-fg">No telemetry</h3>
        <p class="mt-2 text-sm leading-relaxed text-fg-muted">
          The Lens apps collect no analytics or telemetry. See the <a class="text-brand hover:underline" href="/privacy">Privacy Policy</a>.
        </p>
      </div>
    </div>
  </Section>

  <Section eyebrow="Frameworks" eyebrowIcon="code" title="Built for the frameworks your APIs use">
    <div class="mx-auto max-w-3xl overflow-hidden rounded-2xl border border-edge bg-panel">
      <table class="w-full text-left text-sm">
        <tbody>
          {
            frameworks.map((f) => (
              <tr class="border-b border-edge last:border-0">
                <th scope="row" class="w-1/3 px-5 py-3 align-top font-semibold text-fg">{f.language}</th>
                <td class="px-5 py-3 text-fg-muted">{f.list}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </Section>

  <Section
    eyebrow="Plans"
    eyebrowIcon="package"
    title="What each plan includes"
    subtitle="Prices, limits and the full feature list are on the pricing page."
  >
    <div class="grid gap-5 md:grid-cols-3">
      {
        paid.map((plan) => (
          <div class="card flex flex-col">
            <h3 class="text-lg font-semibold text-fg">{plan.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-fg-muted">{plan.blurb}</p>
            <ul class="mt-4 flex-1 space-y-2 text-sm text-fg-muted">
              {plan.capabilities.map((c) => (
                <li class="flex gap-2">
                  <span class="mt-0.5 shrink-0 text-brand">
                    <Icon name="check" size={14} />
                  </span>
                  <span>{c}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="mt-8 text-center">
      <a href="/pricing" class="btn-secondary">Compare plans and prices</a>
    </div>
  </Section>

  <Section eyebrow="Getting started" eyebrowIcon="play" title="How you receive it">
    <ol class="mx-auto max-w-3xl space-y-4 text-sm leading-relaxed text-fg-muted">
      <li class="card">
        <strong class="text-fg">1. Choose a plan.</strong> Create your account at
        <a class="text-brand hover:underline" href={accountUrl}>account.apicircle.dev</a> and choose a plan. Payment is
        handled by Paddle.com, our reseller and merchant of record.
      </li>
      <li class="card">
        <strong class="text-fg">2. Access is immediate.</strong> Your plan is attached to your account the moment
        checkout completes. Nothing is shipped: sign in to the Lens app with the same account and your plan's features
        unlock.
      </li>
      <li class="card">
        <strong class="text-fg">3. Manage it in one place.</strong> Change plan, add seats, activate devices, create
        CLI keys, download invoices or cancel from your account.
      </li>
    </ol>
    <p class="mt-8 text-center text-sm text-fg-muted">
      Questions before you buy? <a class="text-brand hover:underline" href="/contact">Contact us</a>, or read the
      <a class="text-brand hover:underline" href="/terms">Terms of Service</a> and
      <a class="text-brand hover:underline" href="/refunds">Refund Policy</a>.
    </p>
  </Section>
</BaseLayout>
