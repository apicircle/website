---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import CTA from '../../components/CTA.astro';
import Icon from '../../components/Icon.astro';
import { FEATURES } from '../../data/features.ts';
import { SITE } from '../../data/site.ts';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Features', url: '/features' },
];

const toolkit = [
  { icon: 'file-json', title: 'Imports', body: `cURL, OpenAPI/Swagger, Postman, Insomnia, HAR, and portable .apicircle.json — ${SITE.stats.importFormats} formats.` },
  { icon: 'code', title: 'Code generation', body: 'Turn any saved request into cURL, fetch, Node (axios), Python, Go, or Rust.' },
  { icon: 'layers', title: 'Environments', body: 'Priority ordering and cross-workspace variable sources, with encrypted secret rows.' },
  { icon: 'shield-check', title: 'Assertions', body: 'Status, header, body, JSON-path, and duration checks on every response.' },
  { icon: 'workflow', title: 'Execution plans', body: 'Chain requests into multi-step plans, run them with assertions, and replay from history.' },
  { icon: 'boxes', title: 'Global assets', body: 'Reusable JSON Schemas, GraphQL definitions, and file assets tracked alongside the repo.' },
  { icon: 'history', title: 'Request history', body: 'Full headers, body previews, and assertion results for every run — per device.' },
  { icon: 'key', title: 'Secret vault', body: 'AES-GCM encryption, OS-keychain wrapping on desktop, passphrase model on web.' },
];
---
<BaseLayout
  title="Features"
  description="Every API Circle capability and the plan it belongs to: Git-backed collections, local mock servers, 17 auth schemes, execution plans, the VS Code extension, the MCP server and the CLI."
  breadcrumbs={breadcrumbs}
>
  <Section
    headingLevel="h1"
    eyebrow="Features"
    eyebrowIcon="boxes"
    title="Every capability, and the plan it belongs to"
    subtitle="Most of this runs with no account and no subscription, and your collections stay in your own Git repository as JSON you can read. Two of the cards below are paid — the MCP server and the command-line interface — and each one says so."
  >
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {FEATURES.map((feature) => <FeatureCard feature={feature} />)}
    </div>
  </Section>

  <Section
    class="!pt-0"
    eyebrow="In the free workspace"
    eyebrowIcon="zap"
    title="The day-to-day essentials"
    subtitle="Eight more things the workspace does without an account: six import formats, six code-generation targets, JSON-path assertions, multi-step plans, and a vault that wraps its keys in the OS keychain on desktop."
  >
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        toolkit.map((t) => (
          <div class="card flex flex-col gap-3">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-brand/10 text-brand">
              <Icon name={t.icon} size={20} />
            </span>
            <h3 class="text-base font-semibold text-fg">{t.title}</h3>
            <p class="text-sm leading-relaxed text-fg-muted">{t.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <CTA />
</BaseLayout>
