---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppFrame from '../../components/AppFrame.astro';
import Screenshot from '../../components/Screenshot.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import CTA from '../../components/CTA.astro';
import Icon from '../../components/Icon.astro';
import PlanBadge from '../../components/PlanBadge.astro';
import FeatureExtras from '../../components/FeatureExtras.astro';
import Rich from '../../components/Rich.astro';
import { FEATURES } from '../../data/features.ts';
import { LENS_CLOSING_CTA, type CtaLink, type Feature } from '../../data/feature-types.ts';
import { TRIAL_DAYS } from '../../data/pricing.ts';
import { SITE } from '../../data/site.ts';

export function getStaticPaths() {
  return FEATURES.map((feature, i) => ({
    params: { slug: feature.slug },
    props: { feature, next: FEATURES[(i + 1) % FEATURES.length] },
  }));
}

interface Props {
  feature: Feature;
  next: Feature;
}
const { feature, next } = Astro.props;
const isLens = feature.product === 'lens';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Features', url: '/features' },
  { name: feature.title, url: `/features/${feature.slug}` },
];
const keywords = [feature.title, 'API Circle', ...SITE.keywords.slice(0, 8)].join(', ');

/**
 * Only a link that leaves the site opens a new tab and wears the arrow.
 *
 * Every hero button used to carry `target="_blank"` and `arrow-up-right`, so
 * "See what Pro includes" opened /pricing in a second tab and dressed a page on
 * this site as an external one.
 */
const isExternal = (href: string): boolean => /^https?:\/\//.test(href);
const buttons: Array<{ link: CtaLink; kind: string }> = [
  { link: feature.cta, kind: 'btn-primary' },
  ...(feature.secondaryCta ? [{ link: feature.secondaryCta, kind: 'btn-secondary' }] : []),
];

const ACCENT: Record<string, string> = {
  brand: 'text-brand',
  green: 'text-node-green',
  blue: 'text-node-blue',
  amber: 'text-node-amber',
  red: 'text-node-red',
  sky: 'text-node-sky',
};
const accentText = ACCENT[feature.accent] ?? ACCENT.brand;

/**
 * A page about a paid capability ends on the paid product. A Studio page keeps
 * the default (the free web app and the desktop build) unless it overrides it,
 * which the mock page must: the web app cannot run a mock server.
 */
const closing = feature.closingCta ?? (isLens ? LENS_CLOSING_CTA : undefined);
const closingProps = closing
  ? {
      title: closing.title,
      subtitle: closing.subtitle,
      primary: { ...closing.primary, external: isExternal(closing.primary.href) },
      secondary: closing.secondary
        ? { ...closing.secondary, external: isExternal(closing.secondary.href) }
        : null,
    }
  : {};

const hasShot = Boolean(feature.screenshot);
const group = isLens ? { name: 'Lens', href: '/features#lens' } : { name: 'Studio', href: '/features#studio' };
---
<BaseLayout
  title={feature.title}
  description={feature.metaDescription}
  keywords={keywords}
  breadcrumbs={breadcrumbs}
  lens={isLens}
>
  <article>
    <!-- Hero -->
    <section class="relative overflow-hidden border-b border-edge">
      <div class="pointer-events-none absolute inset-0 -z-10">
        <div class="absolute inset-0 bg-grid opacity-[0.12] mask-fade-b"></div>
        <div class="absolute -top-40 right-0 h-96 w-96 rounded-full bg-brand/15 blur-[120px]"></div>
      </div>
      <div class="container-page py-14 sm:py-20">
        <nav class="mb-6 flex flex-wrap items-center gap-2 text-sm text-fg-dim" aria-label="Breadcrumb">
          <a href="/features" class="hover:text-brand">Features</a>
          <Icon name="chevron-down" size={14} class="-rotate-90" />
          <a href={group.href} class="hover:text-brand">{group.name}</a>
          <Icon name="chevron-down" size={14} class="-rotate-90" />
          <span class="text-fg-muted">{feature.navLabel}</span>
        </nav>

        <div class:list={['grid items-center gap-10', hasShot && 'lg:grid-cols-2 lg:gap-16']}>
          <div class:list={[!hasShot && 'max-w-3xl']}>
            <span class:list={['eyebrow', accentText]}>
              <Icon name={feature.icon} size={14} />
              {feature.eyebrow}
            </span>
            <h1 class="mt-4 text-balance text-4xl font-bold tracking-tight text-fg sm:text-5xl">
              {feature.title}
            </h1>
            <p class="mt-5 text-pretty text-lg leading-relaxed text-fg-muted"><Rich text={feature.summary} /></p>
            <p class="mt-5 flex flex-wrap items-center gap-2 text-sm text-fg-dim">
              {
                isLens ? (
                  <>
                    Included from <PlanBadge plan={feature.plan} />
                    <span aria-hidden="true">·</span>
                    {TRIAL_DAYS}-day free trial
                  </>
                ) : (
                  <>
                    <PlanBadge plan="free" />
                    <span aria-hidden="true">·</span>
                    No account needed
                  </>
                )
              }
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              {
                buttons.map(({ link, kind }) => (
                  <a
                    href={link.href}
                    target={isExternal(link.href) ? '_blank' : undefined}
                    rel={isExternal(link.href) ? 'noopener' : undefined}
                    class={kind}
                  >
                    {link.icon && <Icon name={link.icon} size={16} />}
                    {link.label}
                    {isExternal(link.href) && <Icon name="arrow-up-right" size={16} />}
                  </a>
                ))
              }
            </div>
          </div>
          {
            feature.screenshot && (
              <AppFrame label={feature.frameLabel ?? feature.title} class="animate-fade-up">
                <Screenshot name={feature.screenshot} alt={feature.screenshotAlt ?? feature.title} eager />
              </AppFrame>
            )
          }
        </div>
      </div>
    </section>

    {/* With no screenshot, the extras ARE the page's picture, so they come
        straight after the hero rather than below the highlights. */}
    {
      !hasShot && (
        <div class="pt-14 sm:pt-20">
          <FeatureExtras feature={feature} />
        </div>
      )
    }

    <!-- Highlights. With no screenshot the extras above already end in a
         section's bottom padding, so this one does not add its top padding. -->
    <section class:list={['section', !hasShot && '!pt-0']}>
      <div class="container-page">
        <h2 class="sr-only">What it does</h2>
        <div class="grid gap-5 md:grid-cols-2">
          {
            feature.highlights.map((h, i) => (
              <div class="card">
                <div class="flex flex-wrap items-center gap-3">
                  <span class:list={['flex h-8 w-8 items-center justify-center rounded-lg bg-surface text-sm font-bold', accentText]}>
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <h3 class="text-lg font-semibold text-fg">{h.title}</h3>
                  {h.plan && <PlanBadge plan={h.plan} class="ml-auto" />}
                </div>
                <p class="mt-3 text-[15px] leading-relaxed text-fg-muted"><Rich text={h.body} /></p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {hasShot && <FeatureExtras feature={feature} />}

    <!-- Usage / code -->
    {
      feature.sample && (
        <section class="section !pt-0">
          <div class="container-page">
            <div class="mx-auto max-w-3xl rounded-3xl border border-edge bg-panel/50 p-6 sm:p-10">
              <div class="flex flex-wrap items-center gap-3">
                <h2 class="text-2xl font-bold tracking-tight text-fg">{feature.sample.title}</h2>
                {feature.sample.plan && <PlanBadge plan={feature.sample.plan} />}
              </div>
              <p class="mt-3 text-[15px] leading-relaxed text-fg-muted"><Rich text={feature.sample.intro} /></p>
              <div class="mt-6 space-y-4">
                {feature.sample.blocks.map((b) => (
                  <CodeBlock code={b.code} filename={b.filename} lang={b.lang} prompt={b.prompt} />
                ))}
              </div>
            </div>
          </div>
        </section>
      )
    }

    <!-- Next feature -->
    <section class="section !pt-0">
      <div class="container-page">
        <a
          href={`/features/${next.slug}`}
          class="group flex items-center justify-between gap-4 rounded-2xl border border-edge bg-panel p-6 transition-colors hover:border-brand/60"
        >
          <div>
            <span class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-wider text-fg-dim">
              Next feature
              {/* The badge says when the reader crosses from Lens into the free workspace. */}
              <PlanBadge plan={next.plan} />
            </span>
            <p class="mt-1 text-lg font-semibold text-fg group-hover:text-brand">{next.title}</p>
          </div>
          <Icon name="arrow-right" size={22} class="shrink-0 text-fg-dim transition-transform group-hover:translate-x-1 group-hover:text-brand" />
        </a>
      </div>
    </section>

    <CTA {...closingProps} />
  </article>
</BaseLayout>
