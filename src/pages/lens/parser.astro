---
/**
 * How the Code graph parser reads an API, how it was measured, and the result.
 *
 * Every figure on this page is read from `src/data/parser-scores.ts`, which the
 * Lens repo GENERATES by running the parser (`pnpm export:parser-scores`), and is
 * turned into a share by `parser-scores-view.ts`. Never type a score here. Lens
 * fails its own build when the parser changes and that file is not regenerated,
 * so the date this page prints is the parser's.
 *
 * The page never names a project in the corpus. It says how projects were chosen
 * and what each number counts; that is what lets a reader weigh the numbers.
 *
 * The prose explains the figures in words, and words do not regenerate: when a
 * figure moves a long way, re-read the sentence around it.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Stat from '../../components/Stat.astro';
import Rich from '../../components/Rich.astro';
import CTA from '../../components/CTA.astro';
import { LENS_CLOSING_CTA } from '../../data/feature-types.ts';
import { listSentence } from '../../data/frameworks.ts';
import {
  SCORES,
  count,
  documentedFields,
  fixtureOnlyFrameworks,
  longDate,
  ownKeyContradictions,
  ownKeyProjects,
  share,
  unmeasuredFrameworks,
} from '../../data/parser-scores-view.ts';

const real = SCORES.realProjects;
const fx = SCORES.fixtures;
const trace = SCORES.trace;
const measured = longDate(SCORES.measuredOn);
const allFields = documentedFields(real.leaves);
const fixtureMisses = fx.truth - fx.matched;
const traceIsWhole = trace.endpointRecall === 1 && trace.traceRecall === 1 && trace.tracePrecision === 1;
const isAre = (items: string[]): string => (items.length === 1 ? 'is' : 'are');

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'API Circle Lens', url: '/lens' },
  { name: 'Parser', url: '/lens/parser' },
];

const stats = [
  {
    value: share(real.matched, real.truth),
    label: `of documented endpoints found (${count(real.matched)} of ${count(real.truth)})`,
  },
  {
    value: share(real.matched, real.listed),
    label: `of the endpoints Lens listed are documented (${count(real.matched)} of ${count(real.listed)})`,
  },
  {
    value: share(real.leaves.typed, real.leaves.comparable),
    label: `of fields both sides have, typed (${count(real.leaves.typed)} of ${count(real.leaves.comparable)})`,
  },
  {
    value: count(ownKeyContradictions),
    label: `fields contradicted in the ${ownKeyProjects} projects whose answer keys come from their own code`,
  },
];

const passes = [
  {
    title: 'Detect the stack',
    body: 'Lens looks for a framework where a project declares it: a dependency in `package.json`, `requirements.txt` or `pyproject.toml`, a `go.mod`, a `.csproj`, or an import in the source. A repository can hold several stacks, and each one is read by its own adapter.',
  },
  {
    title: 'Find the routes',
    body: 'Each framework declares a route in its own shape, and the adapter reads that shape: a call such as `app.get`, a decorator or attribute such as `@GetMapping` or `[HttpGet]`, a file such as `app/users/route.ts`, or a `urlpatterns` table, where one DRF `router.register` becomes its CRUD routes. Prefixes are joined across files.',
  },
  {
    title: 'Follow the handler',
    body: 'From the handler, Lens walks into every function it calls, across files and through services injected into a controller. TypeScript is read with the TypeScript compiler, Python with Lens’s own reader, and Go, Java, C# and Rust with bundled tree-sitter grammars. The walk stops at a depth and size limit, and records a warning on the endpoint when it does.',
  },
  {
    title: 'Read the contract',
    body: 'Parameters, the request body and each response by status are typed from signatures, DTOs, validators and ORM models. What Lens can’t type stays unknown. A value that exists only at runtime, such as a JSON column or the result of `JSON.parse`, is marked dynamic. Neither is guessed: a guess would surface later as drift that isn’t there.',
  },
];

const answerKeys = [
  {
    kind: 'The project’s own OpenAPI document, generated by its framework or committed in its repository.',
    projects: real.answerKeys.own,
    contradicted: real.codeWrong.own,
  },
  {
    kind: 'Written by hand, line by line, from the project’s handlers and models, because its framework emits nothing usable.',
    projects: real.answerKeys['hand-verified'],
    contradicted: real.codeWrong['hand-verified'],
  },
  {
    kind: 'The public API specification the project set out to implement. Here a contradiction can be the project departing from the specification, and we still count it against the parser.',
    projects: real.answerKeys['shared-spec'],
    contradicted: real.codeWrong['shared-spec'],
  },
];

const definitions = [
  {
    term: 'Endpoints found',
    body: 'An endpoint in the answer key that the Code graph also lists. We match on method and path, read `{id}`, `:id` and `<int:id>` as the same parameter, and ignore a trailing slash.',
  },
  {
    term: 'Listed and documented',
    body: 'The share of the endpoints Lens lists that the answer key documents too. An extra endpoint is either a parser mistake or a real route the key leaves out, a health check for instance. We count every one against the parser without sorting them.',
  },
  {
    term: 'Fields typed',
    body: 'For each matched endpoint, every field of its parameters, request body and responses that both sides have. Typed means a concrete type, read with known confidence. Fields marked dynamic are counted apart.',
  },
  {
    term: 'Contradictions',
    body: 'A field where both sides say something and disagree: its type, whether it’s required, nullable, its format or its enum. It’s the number we hold at zero. A contradiction is what turns into a false drift finding in a review.',
  },
];
---

<BaseLayout
  title="How the Lens parser is measured"
  description={`Lens found ${real.matched} of ${real.truth} documented endpoints in ${real.projects} open-source projects. How its parser reads code, and what each score counts.`}
  breadcrumbs={breadcrumbs}
  lens
>
  <Section
    headingLevel="h1"
    eyebrow="Code graph parser"
    eyebrowIcon="compass"
    title="How Lens reads your API, and how well"
    subtitle={`Lens found ${count(real.matched)} of the ${count(real.truth)} endpoints that ${real.projects} open-source projects document. Every number on this page was measured by running the parser, and says what it counts.`}
  >
    <div class="mx-auto grid max-w-5xl gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {stats.map((s) => <Stat value={s.value} label={s.label} />)}
    </div>
    <p class="mx-auto mt-10 max-w-3xl text-center text-sm leading-relaxed text-fg-dim">
      Measured on {measured}, on the parser as it stood that day. Lens’s own build fails when the
      parser changes and these figures aren’t measured again.
    </p>
  </Section>

  <Section title="How the parser reads an endpoint" align="left">
    <p class="-mt-6 max-w-3xl text-[15px] leading-relaxed text-fg-muted">
      Four passes, in this order. Nothing leaves your machine during any of them.
    </p>
    <ol class="mt-8 grid gap-5 md:grid-cols-2">
      {
        passes.map((pass, i) => (
          <li class="card">
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-surface text-sm font-bold text-brand">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-4 text-base font-semibold text-fg">{pass.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-fg-muted"><Rich text={pass.body} /></p>
          </li>
        ))
      }
    </ol>
    <p class="mt-6 max-w-3xl text-sm leading-relaxed text-fg-dim">
      A repository no adapter claims gets a regex pass that finds route lines and nothing behind them.
      <a class="text-brand hover:underline" href="/features/code-graph">The Code graph page</a> lists every
      framework read at full depth.
    </p>
  </Section>

  <Section eyebrow="Sampling" eyebrowIcon="boxes" title="How we chose the projects" align="left">
    <div class="max-w-3xl space-y-4 text-[15px] leading-relaxed text-fg-muted">
      <p>
        We started from a grid of framework and database library pairs, Express with Prisma or gin with
        GORM for example, and for each pair we could fill, took at least one open-source project that uses
        a real database library and has an answer key. That gave {real.projects} projects in {real.languages.length} languages.
      </p>
      <p>
        Each project is pinned to one commit and cloned at it, so a rerun reads the same code. Every
        project chosen is in the totals. None was dropped for scoring badly.
      </p>
      <p>
        They aren’t a blind test. We used several of them to find gaps in the parser, fixed those gaps,
        and kept the projects in the set. Where an app sets its URL prefix in configuration rather than in
        code, we remove that prefix from the answer key before matching.
      </p>
    </div>
    <div class="mt-8 max-w-4xl overflow-x-auto rounded-2xl border border-edge bg-panel">
      <table class="w-full text-left text-sm">
        <caption class="sr-only">The three kinds of answer key, how many projects use each, and the fields contradicted</caption>
        <thead class="border-b border-edge text-xs uppercase tracking-wide text-fg-dim">
          <tr>
            <th scope="col" class="px-3 py-3 font-semibold sm:px-5">Where the answer key comes from</th>
            <th scope="col" class="whitespace-nowrap px-3 py-3 text-right font-semibold sm:px-5">Projects</th>
            <th scope="col" class="whitespace-nowrap px-3 py-3 text-right font-semibold sm:px-5">Contradicted</th>
          </tr>
        </thead>
        <tbody>
          {
            answerKeys.map((k) => (
              <tr class="border-b border-edge last:border-0">
                <td class="px-3 py-3 text-fg-muted sm:px-5">{k.kind}</td>
                <td class="px-3 py-3 text-right align-top font-semibold text-fg sm:px-5">{k.projects}</td>
                <td class="whitespace-nowrap px-3 py-3 text-right align-top text-fg sm:px-5">{k.contradicted} fields</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </Section>

  <section class="section !pt-0">
    <div class="container-page">
      <h2 class="text-2xl font-bold tracking-tight text-fg">What each number counts</h2>
      <dl class="mt-8 grid gap-5 md:grid-cols-2">
        {
          definitions.map((d) => (
            <div class="card">
              <dt class="text-base font-semibold text-fg">{d.term}</dt>
              <dd class="mt-2 text-sm leading-relaxed text-fg-muted"><Rich text={d.body} /></dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section !pt-0">
    <div class="container-page">
      <h2 class="text-2xl font-bold tracking-tight text-fg">Results by language</h2>
      <p class="mt-3 max-w-3xl text-[15px] leading-relaxed text-fg-muted">
        Each row adds up its projects’ endpoints and fields, so a project with many endpoints weighs more
        than one with a few.
      </p>
      <div class="mt-8 overflow-x-auto rounded-2xl border border-edge bg-panel">
        <table class="w-full min-w-[640px] text-left text-sm">
          <caption class="sr-only">Endpoints found, endpoints documented, fields typed and contradictions, by language</caption>
          <thead class="border-b border-edge text-xs uppercase tracking-wide text-fg-dim">
            <tr>
              <th scope="col" class="px-5 py-3 font-semibold">Language</th>
              <th scope="col" class="px-4 py-3 text-right font-semibold">Projects</th>
              <th scope="col" class="px-4 py-3 text-right font-semibold">Endpoints found</th>
              <th scope="col" class="px-4 py-3 text-right font-semibold">Listed and documented</th>
              <th scope="col" class="px-4 py-3 text-right font-semibold">Fields typed</th>
              <th scope="col" class="px-5 py-3 text-right font-semibold">Contradictions</th>
            </tr>
          </thead>
          <tbody>
            {
              real.byLanguage.map((row) => (
                <tr class="border-b border-edge">
                  <th scope="row" class="px-5 py-3 align-top font-semibold text-fg">
                    {row.language}
                    <span class="mt-0.5 block text-xs font-normal text-fg-dim">{row.frameworks.join(', ')}</span>
                  </th>
                  <td class="px-4 py-3 text-right align-top text-fg-muted">{row.projects}</td>
                  <td class="px-4 py-3 text-right align-top text-fg-muted">
                    <span class="font-semibold text-fg">{share(row.matched, row.truth)}</span>
                    <span class="block text-xs text-fg-dim">{row.matched} of {row.truth}</span>
                  </td>
                  <td class="px-4 py-3 text-right align-top text-fg-muted">
                    <span class="font-semibold text-fg">{share(row.matched, row.listed)}</span>
                    <span class="block text-xs text-fg-dim">{row.matched} of {row.listed}</span>
                  </td>
                  <td class="px-4 py-3 text-right align-top text-fg-muted">
                    <span class="font-semibold text-fg">{share(row.leaves.typed, row.leaves.comparable)}</span>
                    <span class="block text-xs text-fg-dim">{count(row.leaves.typed)} of {count(row.leaves.comparable)}</span>
                  </td>
                  <td class="px-5 py-3 text-right align-top font-semibold text-fg">{row.codeWrong}</td>
                </tr>
              ))
            }
            <tr class="bg-surface/40">
              <th scope="row" class="px-5 py-3 font-semibold text-fg">All {real.languages.length} languages</th>
              <td class="px-4 py-3 text-right font-semibold text-fg">{real.projects}</td>
              <td class="px-4 py-3 text-right font-semibold text-fg">{share(real.matched, real.truth)}</td>
              <td class="px-4 py-3 text-right font-semibold text-fg">{share(real.matched, real.listed)}</td>
              <td class="px-4 py-3 text-right font-semibold text-fg">{share(real.leaves.typed, real.leaves.comparable)}</td>
              <td class="px-5 py-3 text-right font-semibold text-fg">
                {real.codeWrong.own + real.codeWrong['hand-verified'] + real.codeWrong['shared-spec']}
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section !pt-0">
    <div class="container-page">
      <div class="max-w-3xl space-y-4 text-[15px] leading-relaxed text-fg-muted">
        <h2 class="text-2xl font-bold tracking-tight text-fg">What these numbers leave out</h2>
        <p>
          Fields typed counts only the fields both sides have. On the same matched endpoints, the answer
          keys document {count(real.leaves.missing)} more that the code side has nothing for:
          {count(real.missingIn.error)} in error responses, {count(real.missingIn.success)} in success
          responses and {count(real.missingIn.request + real.missingIn.params)} in requests. Against
          everything the answer keys document, Lens typed {count(real.leaves.typed)} of {count(allFields)}
          fields, which is {share(real.leaves.typed, allFields)}. When it misses something in your
          repository, <a class="text-brand hover:underline" href="/features/refinements">Refinements</a> is
          where you add it, and the correction survives a reindex.
        </p>
        <p>
          A success body with a known shape was read for {real.captured} of the {real.matched} matched
          endpoints. An endpoint that answers 204 with no body counts as a miss there too.
        </p>
        <p>
          How far a call tree reaches is measured on {trace.cases} small repositories whose call graphs we
          labelled by hand, and nowhere else.
          {
            traceIsWhole ? (
              <>On those, Lens finds every endpoint and every labelled function, and pulls in nothing else.</>
            ) : (
              <>
                On those, Lens finds {share(trace.endpointRecall, 1)} of the endpoints and
                {' '}{share(trace.traceRecall, 1)} of the labelled functions, and {share(trace.tracePrecision, 1)}
                {' '}of what it pulls in is labelled.
              </>
            )
          }
          Real projects publish no answer key for a call graph.
        </p>
        <p>
          Real projects cover {real.frameworks.length} frameworks.
          {fixtureOnlyFrameworks.length > 0 && `${listSentence(fixtureOnlyFrameworks)} ${isAre(fixtureOnlyFrameworks)} measured by fixtures only.`}
          {unmeasuredFrameworks.length > 0 && `No score on this page covers ${listSentence(unmeasuredFrameworks)} yet.`}
        </p>
      </div>
    </div>
  </section>

  <Section title="The checks that run on every build" align="left">
    <div class="grid gap-5 md:grid-cols-2">
      <div class="card">
        <h3 class="text-base font-semibold text-fg">The fixture suite</h3>
        <p class="mt-2 text-sm leading-relaxed text-fg-muted">
          {fx.cells} small programs across {fx.frameworks.length} frameworks and {fx.orms} database libraries,
          each with an OpenAPI document written together with its code. Lens finds {fx.matched} of their
          {fx.truth} endpoints ({fixtureMisses === 1 ? 'the one it misses is' : 'the ones it misses are'} left
          out of the code on purpose, so the scorer has a miss to catch). It types {count(fx.leaves.typed)}
          of {count(fx.leaves.comparable)} fields, marks {fx.leaves.dynamic} dynamic, and contradicts
          {' '}{fx.codeWrong === 0 ? 'none' : count(fx.codeWrong)}.
        </p>
        <p class="mt-3 text-sm font-semibold text-fg">One untyped field fails the build.</p>
      </div>
      <div class="card">
        <h3 class="text-base font-semibold text-fg">The labelled call graphs</h3>
        <p class="mt-2 text-sm leading-relaxed text-fg-muted">
          {trace.cases} repositories small enough to label by hand: their endpoints, and every function a
          correct trace of each one should reach. Lens’s build fails if the parser finds fewer endpoints,
          misses one of those functions, or pulls in a function that isn’t on the list.
        </p>
      </div>
    </div>
    <p class="mt-6 max-w-3xl text-sm leading-relaxed text-fg-dim">
      The fixtures show the parser handles the shapes we know about. The real projects show how often
      those shapes are enough.
    </p>
  </Section>

  <CTA {...LENS_CLOSING_CTA} />
</BaseLayout>
