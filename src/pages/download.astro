---
/**
 * Where to get things.
 *
 * Two products, in the order someone needs them: Lens, which is what a paid plan
 * gives you, and the free workspace, which needs no account at all.
 *
 * Be careful with platforms here. The Lens desktop build is Windows x64 only
 * (electron-builder.yml defines no mac or linux target, and CI packages
 * `--win nsis --x64`), while Studio desktop ships for all three. Offering a
 * download that does not exist is worse than saying it is not ready.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site.ts';
import { TRIAL_DAYS } from '../data/pricing.ts';

const studioDesktop = [
  { os: 'Windows', note: '.exe installer (x64)' },
  { os: 'macOS', note: '.dmg (Apple Silicon & Intel)' },
  { os: 'Linux', note: 'AppImage & .deb' },
];

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Download', url: '/download' },
];
---
<BaseLayout
  title="Download"
  description="Get API Circle Lens for Windows, or the free API workspace — in the browser, on the desktop for Windows, macOS and Linux, or inside VS Code."
  breadcrumbs={breadcrumbs}
>
  <Section
    headingLevel="h1"
    eyebrow="Download"
    eyebrowIcon="download"
    title="Get API Circle"
    subtitle="Lens is the app with the Code graph and PR Review in it. The API workspace underneath it is free, and you can use that on its own."
  >
    <!-- Lens: the paid app -->
    <div class="card flex flex-col gap-4 sm:flex-row sm:items-start">
      <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand/10 text-brand">
        <Icon name="workflow" size={24} />
      </span>
      <div class="flex-1">
        <h2 class="text-xl font-semibold text-fg">{SITE.lensName}</h2>
        <p class="mt-2 text-sm leading-relaxed text-fg-muted">
          The whole API workspace, plus the panels a paid plan unlocks: the Code graph, PR Review,
          the AI Assistant and MCP setup. Every plan starts with a {TRIAL_DAYS}-day free trial, so
          you can index a repository and review a pull request before you decide.
          <a href="/features#lens" class="text-brand hover:underline">What each panel does →</a>
        </p>
        <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a href={SITE.links.lensReleases} target="_blank" rel="noopener" class="btn-primary">
            <Icon name="download" size={16} />
            Download for Windows
          </a>
          <span class="text-xs leading-relaxed text-fg-dim">
            Windows 10 or later, x64. macOS and Linux builds aren&rsquo;t ready yet.
          </span>
        </div>
        <p class="mt-3 text-xs leading-relaxed text-fg-dim">
          The installer is unsigned until a code-signing certificate is in place, so Windows
          SmartScreen shows a warning on first run. Choose <strong class="text-fg-muted">More info →
          Run anyway</strong>.
        </p>
      </div>
    </div>

    <!-- The free workspace -->
    <h2 class="mt-12 text-lg font-semibold text-fg">The free workspace</h2>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-fg-muted">
      No account, no subscription, nothing to activate. Your collections live in your own Git
      repository as JSON you can read.
    </p>

    {/* min-w-0: a grid item otherwise grows to its longest unbreakable line, and the
        VS Code install command pushed all three cards past a phone screen. */}
    <div class="mt-5 grid gap-5 lg:grid-cols-3">
      <div class="card flex min-w-0 flex-col">
        <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-node-green/10 text-node-green">
          <Icon name="globe" size={22} />
        </span>
        <h3 class="mt-4 text-lg font-semibold text-fg">In the browser</h3>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-fg-muted">
          Nothing to install. Your first workspace is created the moment you open it.
        </p>
        <a href={SITE.appUrl} target="_blank" rel="noopener" class="btn-secondary mt-5 w-full">
          Open studio.apicircle.dev
          <Icon name="arrow-up-right" size={16} />
        </a>
      </div>

      <div class="card flex min-w-0 flex-col">
        <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-node-blue/10 text-node-blue">
          <Icon name="monitor" size={22} />
        </span>
        <h3 class="mt-4 text-lg font-semibold text-fg">On the desktop</h3>
        <p class="mt-2 text-sm leading-relaxed text-fg-muted">
          Secrets in your OS keychain, and mock servers that keep running.
        </p>
        <div class="mt-4 grid gap-2">
          {
            studioDesktop.map((d) => (
              <a
                href={SITE.links.releases}
                target="_blank"
                rel="noopener"
                class="flex items-center justify-between rounded-xl border border-edge bg-surface/60 px-3 py-2 transition-colors hover:border-brand hover:text-brand"
              >
                <span class="text-sm font-semibold text-fg">{d.os}</span>
                <span class="text-[11px] leading-tight text-fg-dim">{d.note}</span>
              </a>
            ))
          }
        </div>
        <p class="mt-3 text-xs leading-relaxed text-fg-dim">
          Unsigned builds, so expect a one-time OS prompt.
          <a href={`${SITE.docsBase}/installing.md`} target="_blank" rel="noopener" class="text-brand hover:underline">Installing guide →</a>
        </p>
      </div>

      <div class="card flex min-w-0 flex-col">
        <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-node-sky/10 text-node-sky">
          <Icon name="code" size={22} />
        </span>
        <h3 class="mt-4 text-lg font-semibold text-fg">In VS Code</h3>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-fg-muted">
          The same workspace, edited as YAML, with a Send CodeLens on every request.
        </p>
        <div class="mt-4">
          <CodeBlock code="code --install-extension apicircle.apicircle-vscode" prompt lang="Install" />
        </div>
        <div class="mt-3 flex gap-3 text-sm">
          <a href={SITE.links.vscode} target="_blank" rel="noopener" class="text-brand hover:underline">Marketplace</a>
          <a href={SITE.links.openVsx} target="_blank" rel="noopener" class="text-brand hover:underline">Open VSX</a>
        </div>
      </div>
    </div>

    <!-- CLI -->
    <h2 class="mt-12 text-lg font-semibold text-fg">For CI</h2>
    <div class="mt-4 card">
      <p class="max-w-2xl text-sm leading-relaxed text-fg-muted">
        The command line runs the same drift check against a cloned repository and exits with a code
        your pipeline can act on. It also carries the MCP server, which starts as
        <code class="rounded bg-surface px-1.5 py-0.5 text-[13px] text-fg">apicircle-lens mcp</code>.
        The CLI is part of the Team plan and the MCP server is part of Pro; both authenticate with a
        key from your account rather than a device seat.
      </p>
      <div class="mt-4 max-w-xl">
        <CodeBlock code="npm install -g @apicircle-lens/cli" prompt lang="Install (Node 20+)" />
      </div>
      <div class="mt-3 flex flex-wrap gap-4 text-sm">
        <a href={SITE.links.npmCli} target="_blank" rel="noopener" class="text-brand hover:underline">View on npm →</a>
        <a href="/features/cli" class="text-brand hover:underline">What it does in CI →</a>
        <a href="/pricing" class="text-brand hover:underline">Plans →</a>
      </div>
    </div>
  </Section>
</BaseLayout>
